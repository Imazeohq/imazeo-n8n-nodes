{
	"name": "@imazeo/n8n-nodes-imazeo",
	"version": "1.0.0",
	"description": "n8n community node for Imazeo image transforms, PDF tools, QR codes, and barcodes",
	"license": "MIT",
	"homepage": "https://imazeo.com",
	"keywords": [
		"n8n-community-node-package",
		"imazeo",
		"images",
		"transforms",
		"pdf",
		"qr",
		"barcode"
	],
	"publishConfig": {
		"access": "public"
	},
	"author": {
		"name": "Imazeo",
		"email": "contact@imazeo.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Imazeohq/imazeo-n8n-nodes.git"
	},
	"bugs": {
		"url": "https://github.com/Imazeohq/imazeo-n8n-nodes/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --import tsx test/GenericFunctions.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"workflows"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ImazeoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Imazeo/Imazeo.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.55.6",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"tsx": "4.20.5",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
